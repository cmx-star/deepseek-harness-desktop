{
  "name": "dsh-tauri-tool-router",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dsh-tauri": "workspace:*"
  },
  "devDependencies": {
    "dsh-tauri-tsdown": "workspace:*",
    "tsdown": "catalog:cli"
  }
}
